{
  "extends": "../../tsconfig.json",
  "compilerOptions": {
    "lib": ["ES2023"],
    "types": ["node"],
    "paths": {
      "openclaw/plugin-sdk": ["./node_modules/openclaw/plugin-sdk"]
    },
    "typeRoots": ["../../node_modules/@types"],
    "skipLibCheck": true,
    "moduleResolution": "NodeNext",
    "module": "NodeNext"
  },
  "include": ["./index.ts", "./session-manager.ts", "./*.d.ts"],
  "exclude": ["node_modules"]
}
